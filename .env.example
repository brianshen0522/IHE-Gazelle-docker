# ============================================================
# IHE Gazelle Test Bed — global configuration template
# Copy to .env and edit:  cp .env.example .env
# After changing PUBLIC_*: run ./scripts/apply-public-url.sh
# For anything else:       docker compose up -d
# Full reference: docs/03-configuration.md
# ============================================================

# ---- Public address ----
# Mode A (local http, no external proxy):
#   PUBLIC_SCHEME=http / PUBLIC_HOST=gazelle.localhost / PUBLIC_PORT=8888
#   PUBLIC_URL=http://gazelle.localhost:8888 / PUBLIC_HOSTPORT=gazelle.localhost:8888
#   NGINX_NETWORK_ALIAS=gazelle.localhost   (same as PUBLIC_HOST)
# Mode B (production, external TLS proxy on a SEPARATE machine; proxy
#   requirements in docs/03): as in the example below. PUBLIC_HOST must resolve
#   to that proxy via real DNS from INSIDE the containers.
# NOTE: hostnames must not contain underscores (Keycloak NPEs on every request).
PUBLIC_SCHEME=https
PUBLIC_HOST=gazelle.example.com
PUBLIC_PORT=443
PUBLIC_URL=https://gazelle.example.com
PUBLIC_HOSTPORT=gazelle.example.com

# Host port of the stack's own nginx
NGINX_HTTP_PORT=8888
# Mode A: set equal to PUBLIC_HOST. Mode B: set a useless placeholder
# (compose rejects empty aliases).
NGINX_NETWORK_ALIAS=gazelle-nginx-internal.localhost

# ---- Database ----
DB_USER=gazelle
DB_PASSWORD=change-me-db-password
DB_TM_NAME=gazelle-tm
DB_PUBLISHED_PORT=5433

# ---- Keycloak ----
# CHANGE these defaults before exposing the stack anywhere.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-kc-admin
SSO_CLIENTS_ADMIN_USER=gazelle-clients-admin
SSO_CLIENTS_ADMIN_PASSWORD=change-me-clients-admin
SSO_ADMIN_EMAIL=admin@example.com

# ---- m2m client secrets (one per service; use independent random values) ----
TM_M2M_SECRET=change-me-tm-m2m
SREG_M2M_SECRET=change-me-sreg-m2m
SGW_M2M_SECRET=change-me-sgw-m2m
VGW_M2M_SECRET=change-me-vgw-m2m
XVS_M2M_SECRET=change-me-xvs-m2m
MAESTRO_M2M_SECRET=change-me-maestro-m2m
GUM_M2M_SECRET=change-me-gum-m2m

# ---- SMTP (shared by all three mail senders: Keycloak / GUM / TM) ----
# Defaults to the stack's built-in fake SMTP (mailpit; inbox at ${PUBLIC_URL}/mailpit/).
# For a real server: change HOST/PORT/credentials, set SMTP_TRUST_ALL=false and
# pick either STARTTLS or SSL depending on the server.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=gazelle
SMTP_PASSWORD=change-me-smtp
# Encryption — pick one: STARTTLS (587/1025) or implicit TLS/SMTPS (465);
# both false = plaintext.
SMTP_STARTTLS=true
# GUM's (Quarkus) equivalent — keep in sync with SMTP_STARTTLS:
#   true → REQUIRED / false → DISABLED
SMTP_STARTTLS_MODE=REQUIRED
SMTP_SSL=false
# Sender = no-reply@<this domain>
SMTP_FROM_DOMAIN=gazelle.example.com
# GUM mock mode (true = log only, never actually send)
SMTP_MOCK_ENABLED=false
# true for self-signed servers (the built-in mailpit); false for real servers
# with publicly trusted CAs.
SMTP_TRUST_ALL=true

# ---- Miscellaneous ----
NEXTAUTH_SECRET=change-me-nextauth-secret
TZ=Asia/Taipei
# m2m token audience — must equal the realm's audience-mapper value:
# On a FRESH database (down -v reinstall) the mapper is created from
# ROOT_TEST_BED_URL (= PUBLIC_URL) → set this to PUBLIC_URL.
# If you later change PUBLIC_URL without rebuilding the DB, the mapper stays
# frozen at the old value → this must follow the mapper, not PUBLIC_URL.
M2M_AUDIENCE=https://gazelle.example.com
