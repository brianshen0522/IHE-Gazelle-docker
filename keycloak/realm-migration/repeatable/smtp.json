{
  "enabled": true,
  "realm": "$(env:REALM:-gazelle)",
  "smtpServer": {
    "password": "$(env:SMTP_PASSWORD)",
    "starttls": "$(env:SMTP_STARTTLS:-false)",
    "auth": "true",
    "envelopeFrom": "",
    "port": "$(env:SMTP_PORT)",
    "host": "$(env:SMTP_HOST)",
    "from": "no-reply@$(env:SMTP_FROM_DOMAIN:-$(env:FQDN))",
    "ssl": "$(env:SMTP_SSL:-false)",
    "user": "$(env:SMTP_USERNAME)"
  }
}
