{
  "enabled": true,
  "realm": "master",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "users": [
    {
      "username": "$(GZL_SSO_ADMIN_USER:-gazelle-clients-admin)",
      "email": "$(env:GZL_SSO_ADMIN_EMAIL:-indus@kereval.com)",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "$(env:GZL_SSO_ADMIN_PASSWORD)"
        }
      ],
      "clientRoles": {
        "gazelle-realm": [
          "manage-users",
          "manage-clients",
          "manage-realm"
        ]
      }
    }
  ]
}