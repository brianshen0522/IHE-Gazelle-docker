{
  "enabled": true,
  "realm": "master",
  "users": [
    {
      "username": "$(GZL_SSO_ADMIN_USER:-gazelle-clients-admin)",
      "email": "$(env:GZL_SSO_ADMIN_EMAIL:-indus@kereval.com)",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "$(env:GZL_SSO_ADMIN_PASSWORD)"
        }
      ],
      "clientRoles": {
        "gazelle-realm": [
          "manage-users",
          "manage-clients",
          "manage-realm"
        ]
      }
    }
  ]
}