{
  "name": "gazelle-user-interface",
  "version": "4.0.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "analyze": "next experimental-analyze",
    "lint": "eslint src",
