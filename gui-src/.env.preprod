APP_VERSION="2.3.0-SNAPSHOT"
REGISTRY_APP="rg.fr-par.scw.cloud/gazelle-snapshot"
HOSTNAME="0.0.0.0"
SCHEME="http"
FQDN="localhost:3000"
PORT="3030"

# GLOBAL
BASE_URL="${SCHEME}://${FQDN}/gazelle"
#GZL_EXCLUDED_PATHS="/test-execution/poc"

# AUTH
KEYCLOAK_ISSUER="https://preprod.ihe-europe.net/auth/realms/gazelle"
KEYCLOAK_CLIENT_ID="OIDC_GAZELLE_CLIENT"
NEXTAUTH_URL="${BASE_URL}/api/auth/"
NEXTAUTH_SECRET="secret"

# BACK URLs
GZL_GUM_API_URL="https://preprod.ihe-europe.net/gum/rest"
GZL_TM_URL="https://preprod.ihe-europe.net/tm"
GZL_SERVICE_REGISTRY_URL="https://preprod.ihe-europe.net/service-registry"

## MESSAGE CAPTURE
GZL_DTH_API_URL="https://preprod.ihe-europe.net/datahouse/rest/v1"
GZL_DTH_VALIDATION_ENABLED="true"
GZL_DTH_EVSGATEWAY_URL="https://preprod.ihe-europe.net/evsgateway/rest/v1"
NEXT_PUBLIC_MESSAGE_CAPTURE_API_URL="/gazelle/message-capture/api"
GDH_PRESENTATION_SCHEMA_PATH="/opt/gazelle-user-interface/message-capture/presentationSchemas.json"

# FRONT URL
GZL_REGISTRATION_URL="${BASE_URL}/user-management/registration"

## HOME
GZL_HOME_CONFIGURATION_FOLDER=/opt/gazelle/user-interface

# TEST EXECUTION
GZL_TEST_CASE_FOLDER=/opt/gazelle-user-interface/test-execution/test-case/
GZL_TEST_EXECUTION_URL="https://preprod.ihe-europe.net/test-execution"
GZL_TEST_EXECUTION_WEBSOCKET_URL="wss://preprod.ihe-europe.net/test-execution"
GZL_MAESTRO_URL=https://preprod.ihe-europe.net/maestro
GZL_MAESTRO_WEBSOCKET_URL=wss://preprod.ihe-europe.net/maestro
GZL_TEST_MODEL_REPOSITORY_URL="https://preprod.ihe-europe.net/test-model-repository"

# SIMULATION PORTAL
GZL_SIMULATION_GATEWAY_URL="https://preprod.ihe-europe.net/simulation-gateway/rest/simulation/v1/sequences"
GZL_SIMULATION_REQUEST_TIMEOUT_SECONDS=60

# VALIDATION PORTAL
GZL_VALIDATION_GATEWAY_URL="https://preprod.ihe-europe.net/validation-gateway/rest/v1/profiles"