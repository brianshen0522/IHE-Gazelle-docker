# GLOBAL
APP_VERSION="1.0.0-SNAPSHOT"
REGISTRY_APP="rg.fr-par.scw.cloud/gazelle-snapshot"
REGISTRY_PATH="app"
QUARKUS_HTTP_PORT_GATEWAY=8087
QUARKUS_SWAGGER_UI_ENABLE=true
FQDN="localhost:8087"
SCHEME="http"

# LIMITS
MAX_FILE=3
MAX_SIZE=10m
MEM_RESERVATION=512m
MEM_LIMIT=1024m

# GZL
GZL_TERMS_OF_SERVICE_URL=https://www.ihe-europe.net/privacy-policy
GZL_SERVICE_REGISTRY_URL=http://localhost:8088/service-registry
GZL_SERVICE_K8S_ID=simulation-gateway-12345-123
GZL_SVS_URL=${SCHEME}://${FQDN}/SVSSimulator/rest
GZL_SIMULATION_GATEWAY_SERVICES_CACHE_TIMEOUT_MINUTES=2
GZL_SIMULATION_GATEWAY_SEQUENCES_CACHE_MAX_TIMEOUT_MINUTES=720

# M2M
GZL_ROOT_TEST_BED_URL=${SCHEME}://${FQDN}
GZL_SSO_URL=${SCHEME}://${FQDN}/auth
GZL_SSO_ADMIN_USER=gazelle-clients-admin
GZL_SSO_ADMIN_PASSWORD=gazelle
GZL_M2M_CLIENT_SECRET=secret