<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
<persistence-unit name="gum-store" transaction-type="JTA">
    <class>net.ihe.gazelle.user.management.commons.interlay.dao.entities.UserEntity</class>
    <class>net.ihe.gazelle.user.management.commons.interlay.dao.entities.OrganizationEntity</class>
    <class>net.ihe.gazelle.user.management.commons.interlay.dao.entities.DelegatedOrganizationEntity</class>
    <class>net.ihe.gazelle.user.management.commons.interlay.dao.entities.DelegatedUserEntity</class>
    <class>net.ihe.gazelle.user.management.commons.interlay.dao.entities.ConsentEntity</class>
    <class>net.ihe.gazelle.user.management.commons.interlay.dao.entities.ConsentHistoryEntity</class>
    <class>net.ihe.gazelle.user.management.commons.interlay.dao.entities.CredentialsEntity</class>
    <class>net.ihe.gazelle.user.management.commons.interlay.dao.entities.UserPreferenceEntity</class>
    <class>net.ihe.gazelle.user.management.commons.interlay.dao.entities.GroupEntity</class>

    <properties>
        <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect" />
        <property name="hibernate.connection.datasource" value="gum-store" />
        <property name="jakarta.persistence.transactionType" value="JTA" />
        <property name="hibernate.hbm2ddl.auto" value="none" />
        <property name="hibernate.show_sql" value="false" />
    </properties>
</persistence-unit>
</persistence>